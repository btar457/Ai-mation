"lines": [
{
"id": "01a",
"who": "caesar",
"text": "يقولون إنَّ في بلادِ العربِ رجلاً لا يردُّ سائلاً...",
"start": 0.15,
"dur": 3.925
},
{
"id": "01b",
"who": "caesar",
"text": "لا أُصدِّق.",
"start": 4.375,
"dur": 1.003
},
{
"id": "02a",
"who": "caesar",
"text": "اذهبْ إليه، واطلبْ منه أعزَّ ما يملك: فرسَه.",
"start": 6.078,
"dur": 4.032
},
{
"id": "03a",
"who": "hajib",
"text": "سنرى إن كان كرمُه حقيقةً...",
"start": 10.81,
"dur": 2.773
},
{
"id": "03b",
"who": "hajib",
"text": "أم حكاية.",
"start": 13.883,
"dur": 0.811
},
{
"id": "04a",
"who": "narr",
"text": "وسارَ الحاجبُ أياماً في البادية،",
"start": 15.394,
"dur": 2.005
},
{
"id": "04b",
"who": "narr",
"text": "حتى وصلَ ديارَ طيّء، في ليلةٍ باردة.",
"start": 17.699,
"dur": 2.709
},
{
"id": "05a",
"who": "hatim",
"text": "أهلاً بالضيف!",
"start": 21.109,
"dur": 1.216
},
{
"id": "05b",
"who": "hatim",
"text": "انزلْ، فالبيتُ بيتُك.",
"start": 22.625,
"dur": 1.557
},
{
"id": "06a",
"who": "hajib",
"text": "لن أُخبرَه بحاجتي...",
"start": 24.882,
"dur": 1.728
},
{
"id": "06b",
"who": "hajib",
"text": "حتى أرى كيف يُكرمُني.",
"start": 26.91,
"dur": 1.877
},
{
"id": "07a",
"who": "narr",
"text": "لكنَّ إبلَ حاتمٍ كانت في المراعي البعيدة،",
"start": 29.487,
"dur": 2.923
},
{
"id": "07b",
"who": "narr",
"text": "ولم يكن في البيتِ ما يُذبَح.",
"start": 32.71,
"dur": 1.749
},
{
"id": "08a",
"who": "mawiya",
"text": "يا حاتم...",
"start": 35.159,
"dur": 0.747
},
{
"id": "08b",
"who": "mawiya",
"text": "ليس عندنا ما نَقري به ضيفَنا الليلة.",
"start": 36.206,
"dur": 2.624
},
{
"id": "09a",
"who": "narr",
"text": "لم يبقَ إلا شيءٌ واحد...",
"start": 39.53,
"dur": 1.749
},
{
"id": "10a",
"who": "hatim",
"text": "أنتِ أعزُّ ما أملك...",
"start": 41.98,
"dur": 1.451
},
{
"id": "11a",
"who": "hatim",
"text": "لكنَّ الضيفَ أعزّ.",
"start": 44.38,
"dur": 1.685
},
{
"id": "12a",
"who": "narr",
"text": "وفي تلك الليلة...",
"start": 46.78,
"dur": 1.067
},
{
"id": "12b",
"who": "narr",
"text": "أوقدَ حاتمٌ نارَه.",
"start": 48.146,
"dur": 1.344
},
{
"id": "13a",
"who": "hajib",
"text": "ما ذقتُ في حياتي طعاماً أطيبَ من هذا!",
"start": 50.19,
"dur": 3.051
},
{
"id": "14a",
"who": "hatim",
"text": "كُلْ يا أخي...",
"start": 53.941,
"dur": 1.408
},
{
"id": "14b",
"who": "hatim",
"text": "فما جئتَ إلا لتُكرَم.",
"start": 55.649,
"dur": 1.493
},
{
"id": "15a",
"who": "hajib",
"text": "غداً أطلبُ الفرس...",
"start": 57.842,
"dur": 1.899
},
{
"id": "15b",
"who": "hajib",
"text": "وأرى وجهَه.",
"start": 60.041,
"dur": 2.581
},
{
"id": "16a",
"who": "narr",
"text": "وفي الصباح...",
"start": 63.322,
"dur": 0.832
},
{
"id": "17a",
"who": "hajib",
"text": "يا حاتم، لستُ ضيفاً عادياً.",
"start": 65.722,
"dur": 2.453
},
{
"id": "17b",
"who": "hajib",
"text": "أنا حاجبُ قيصر، ملكِ الروم.",
"start": 68.476,
"dur": 2.987
},
{
"id": "18a",
"who": "hatim",
"text": "حاجبُ قيصر؟",
"start": 72.162,
"dur": 1.109
},
{
"id": "18b",
"who": "hatim",
"text": "في بيتي؟",
"start": 73.572,
"dur": 1.796
},
{
"id": "19a",
"who": "hajib",
"text": "بلغَ الملكَ كرمُك،",
"start": 76.068,
"dur": 1.536
},
{
"id": "19b",
"who": "hajib",
"text": "فأرسلني أطلبُ منك هديةً واحدة...",
"start": 77.904,
"dur": 2.923
},
{
"id": "21a",
"who": "hajib",
"text": "فرسَك...",
"start": 84.126,
"dur": 2.316
},
{
"id": "21b",
"who": "hajib",
"text": "أعزَّ ما تملك.",
"start": 86.742,
"dur": 1.28
},
{
"id": "22a",
"who": "narr",
"text": "فماذا سيقولُ حاتم...",
"start": 89.872,
"dur": 1.472
},
{
"id": "22b",
"who": "narr",
"text": "وقد أكلَ الحاجبُ الفرسَ بنفسِه البارحة؟",
"start": 91.644,
"dur": 2.709
}
