   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "13c",
  "who": "narr",
  "text": "أوقِدْ فإنَّ الليلَ ليلٌ قَرّ…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "13d",
  "who": "narr",
  "text": "عسى يرى نارَك مَن يمُرّ…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "13e",
  "who": "narr",
  "text": "إن جلبتَ ضيفاً فأنتَ حُرّ.",
