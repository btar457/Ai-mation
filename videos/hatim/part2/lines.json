   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "03a",
  "who": "hatim",
  "text": "لقد نحرتُها لك البارحة…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "03b",
  "who": "hatim",
  "text": "إذ لم أجد غيرَها.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "04a",
  "who": "hajib",
  "text": "الفرس؟!",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "04b",
  "who": "hajib",
  "text": "التي أكلتُ منها؟",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "05a",
  "who": "mawiya",
  "text": "والله ما بات في البيتِ غيرُها.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "06a",
  "who": "hajib",
  "text": "جئتُ أختبرُ كرمَه…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "06b",
  "who": "hajib",
  "text": "فأطعمَني أعزَّ ما يملك.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "07a",
  "who": "hatim",
  "text": "لا عليك يا أخي…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "07b",
  "who": "hatim",
  "text": "ما كانت لتكونَ أكرمَ منها في بطنِ ضيف.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "08a",
  "who": "hajib",
  "text": "والله…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "08b",
  "who": "hajib",
  "text": "لقد رأينا منك أكثرَ مما سمعنا.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "09a",
  "who": "narr",
  "text": "ويُروى أنّ إبلَ حاتمٍ عادت من المراعي…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "10a",
  "who": "narr",
  "text": "فأبى أن يعودَ الرسولُ إلا محمّلاً بالعطايا.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "11a",
  "who": "hajib",
  "text": "يا مولاي، طلبنا فرسَه…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "11b",
  "who": "hajib",
  "text": "فذبحها لنا قبل أن يعرفَ حاجتَنا.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "12a",
  "who": "caesar",
  "text": "رجلٌ يُطعِمُ ضيفَه أعزَّ ما يملك…",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "12b",
  "who": "caesar",
  "text": "لا يُختبَرُ كرمُه.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "13a",
  "who": "narr",
  "text": "ومن يومِها يقولُ العرب: أجودُ من حاتم.",
  "seeds": [
   1,
   2,
   3,
   4
  ]
 },
 {
  "id": "13b",
  "who": "narr",
  "text": "ويُروى أنه كان يقولُ لغلامِه:",
