[{"t": "انظر إلى خريطة العراق.", "s": 0.0, "e": 1.74}, {"t": "خطوط مستقيمة تقطع الصحراء،", "s": 2.55, "e": 4.93}, {"t": "كأنها رُسمت بالمسطرة.", "s": 5.49, "e": 7.06}, {"t": "والحقيقة؟", "s": 7.82, "e": 8.58}, {"t": "أنها رُسمت بالمسطرة فعلاً.", "s": 9.22, "e": 11.3}, {"t": "قبل مئة عام،", "s": 12.12, "e": 13.14}, {"t": "لم تكن هناك دولة اسمها العراق.", "s": 13.49, "e": 15.84}, {"t": "كانت هناك ثلاث ولايات عثمانية:", "s": 16.46, "e": 18.93}, {"t": "الموصل، وبغداد، والبصرة.", "s": 19.64, "e": 22.08}, {"t": "في عام 1916،", "s": 22.85, "e": 25.55}, {"t": "اتفقت بريطانيا وفرنسا سراً على تقاسم المنطقة،", "s": 25.91, "e": 30.05}, {"t": "في اتفاقية سايكس بيكو.", "s": 30.43, "e": 32.28}, {"t": "والمفاجأة؟", "s": 32.96, "e": 33.73}, {"t": "أن الموصل كانت من حصة فرنسا.", "s": 34.29, "e": 36.61}, {"t": "لكن بريطانيا احتلت الموصل بعد الحرب،", "s": 37.36, "e": 40.13}, {"t": "ونازعتها تركيا عليها،", "s": 40.63, "e": 42.35}, {"t": "حتى حُسم أمرها لصالح العراق عام 1926.", "s": 42.74, "e": 48.59}, {"t": "وفي الجنوب،", "s": 49.43, "e": 50.17}, {"t": "جلس المندوب البريطاني بيرسي كوكس في العُقير،", "s": 50.63, "e": 53.66}, {"t": "ورسم بقلمه الحدود مع نجد والكويت،", "s": 54.14, "e": 57.11}, {"t": "وترك بينها مناطق محايدة.", "s": 57.66, "e": 59.92}, {"t": "والنتيجة؟", "s": 60.69, "e": 61.36}, {"t": "دولة بساحل بحري لا يتجاوز ستين كيلومتراً،", "s": 61.96, "e": 66.17}, {"t": "وحدود لم يرسمها أهلها.", "s": 66.69, "e": 68.61}, {"t": "هذه الحدود التي نراها ثابتة،", "s": 69.43, "e": 71.59}, {"t": "عمرها مئة عام فقط.", "s": 72.07, "e": 73.95}]