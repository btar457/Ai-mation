{
 "duration": 178.629,
 "segments": [
  {
   "tag": "hook",
   "who": "I",
   "start": 0.0,
   "end": 4.3,
   "text": "أين الأسِرّةُ والتيجانُ والحُلَلُ؟"
  },
  {
   "tag": "intro",
   "who": "R",
   "start": 4.85,
   "end": 12.024,
   "text": "يُروى أنّ هذه الأبيات… أبكت أقوى رجلٍ في دولةِ بني العباس."
  },
  {
   "tag": "story",
   "who": "R",
   "start": 12.724,
   "end": 60.297,
   "text": "في سامرّاء، وشى الوشاةُ إلى الخليفةِ المتوكل: إنّ في بيتِ عليِّ بنِ محمدٍ الهادي سلاحاً… وكتباً من شيعته. فأرسل إليه جنودَه من الأتراك… في جوفِ الليل. هجموا على البيت… فوجدوه وحدَه، في بيتٍ مغلق، عليه مِدرعةٌ من شَعر، لا فراشَ تحته إلا الرملُ والحصى، يرتّلُ آياتٍ من القرآن. ولم يجدوا في بيته شيئاً مما قيل. فحملوه كما هو… إلى قصرِ المتوكل. دخل عليه، والخليفةُ يشرب… وفي يده كأس. فأجلسه إلى جانبه… ثم ناوله الكأس."
  },
  {
   "tag": "refuse",
   "who": "I",
   "start": 60.597,
   "end": 67.197,
   "text": "ما خامرَ لحمي ودمي قطّ… فاعفِني منه."
  },
  {
   "tag": "ask_r",
   "who": "R",
   "start": 67.497,
   "end": 69.575,
   "text": "فأعفاه، وقال:"
  },
  {
   "tag": "ask",
   "who": "M",
   "start": 69.675,
   "end": 74.245,
   "text": "أنشِدني شعراً أستحسنُه."
  },
  {
   "tag": "little",
   "who": "I",
   "start": 74.545,
   "end": 78.795,
   "text": "إنّي لقليلُ الروايةِ للشعر."
  },
  {
   "tag": "insist",
   "who": "M",
   "start": 79.045,
   "end": 82.512,
   "text": "لا بدّ أن تُنشدَني!"
  },
  {
   "tag": "insist_r",
   "who": "R",
   "start": 82.712,
   "end": 83.833,
   "text": "فأنشده:"
  },
  {
   "tag": "v1",
   "who": "I",
   "start": 84.283,
   "end": 94.483,
   "text": "باتوا على قُلَلِ الأجبالِ تحرسُهم… غُلْبُ الرجالِ، فما أغنتهمُ القُلَلُ"
  },
  {
   "tag": "v2",
   "who": "I",
   "start": 94.983,
   "end": 104.683,
   "text": "واستُنزِلوا بعد عزٍّ عن معاقلِهم… فأُودِعوا حُفَراً، يا بئسَ ما نزلوا"
  },
  {
   "tag": "v3",
   "who": "I",
   "start": 105.183,
   "end": 115.183,
   "text": "ناداهمُ صارخٌ من بعدِ ما قُبِروا… أين الأسِرّةُ والتيجانُ والحُلَلُ؟"
  },
  {
   "tag": "v4",
   "who": "I",
   "start": 115.683,
   "end": 125.083,
   "text": "أين الوجوهُ التي كانت مُنعَّمةً… من دونِها تُضرَبُ الأستارُ والكِلَلُ؟"
  },
  {
   "tag": "v5",
   "who": "I",
   "start": 125.583,
   "end": 135.283,
   "text": "فأفصحَ القبرُ عنهم حين ساءلَهم… تلك الوجوهُ عليها الدودُ يقتتلُ"
  },
  {
   "tag": "v6",
   "who": "I",
   "start": 135.783,
   "end": 144.983,
   "text": "قد طالما أكلوا دهراً وما شربوا… فأصبحوا بعد طولِ الأكلِ قد أُكِلوا"
  },
  {
   "tag": "end",
   "who": "R",
   "start": 145.883,
   "end": 177.029,
   "text": "فأشفقَ كلُّ من حضر على الإمام… وظنّوا أنّ الخليفةَ سيبطشُ به. لكنّ المتوكل… بكى بكاءً طويلاً، حتى بلّت دموعُه لحيتَه. وبكى كلُّ من في المجلس. ثم أمر برفعِ الشراب… وردّه إلى بيته مُكرَّماً. أبياتٌ قيلت قبل أكثرَ من ألفٍ ومئةِ عام… وما زالت تسألُ كلَّ صاحبِ سلطان: أين الأسِرّةُ والتيجانُ والحُلَل؟"
  }
 ],
